<Window x:Class="Nova.App.Features.DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Island" AutomationProperties.Name="NOVA Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" KeyDown="OnKeyDown" Deactivated="OnDeactivated"
        SourceInitialized="OnSourceInitialized" SizeChanged="OnSizeChanged">
  <Border x:Name="Pill" CornerRadius="22" Padding="14,5" BorderThickness="1" ClipToBounds="True"
          Background="{DynamicResource NovaSurface}" BorderBrush="{DynamicResource NovaBorder}"
          AllowDrop="True" MouseLeftButtonUp="OnPillClick" MouseEnter="OnPillEnter" MouseLeave="OnPillLeave"
          DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <StackPanel>

      <!-- Compact row: album art | lyric line (wraps, the Island grows with it) or title + artist | play/pause | equalizer -->
      <Grid x:Name="TimeRow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="MiniArt" Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                CornerRadius="9" Visibility="Collapsed" Background="{DynamicResource NovaSurfaceAlt}">
          <Image x:Name="MiniArtImage" Width="34" Height="34" Stretch="UniformToFill"/>
        </Border>
        <StackPanel x:Name="TextCol" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="TimeText" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
          <TextBlock x:Name="SubText" HorizontalAlignment="Left" TextAlignment="Left" FontSize="11" Opacity="0.6" Margin="0,1,0,0"
                     TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{DynamicResource NovaOnSurface}"/>
        </StackPanel>
        <!-- A small animated face that takes the clock's place for a few seconds (Settings: Island face) -->
        <Border x:Name="FaceBox" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" AutomationProperties.Name="Wajah Island"/>
        <Button x:Name="MiniPlay" Grid.Column="2" Style="{StaticResource NovaIconButton}" Width="30" Height="30" FontSize="14" Margin="8,0,0,0"
                VerticalAlignment="Center" Visibility="Collapsed" Content="&#xE769;"
                ToolTip="Putar / jeda" AutomationProperties.Name="Putar atau jeda" Click="OnPlayClick"/>
        <StackPanel x:Name="Eq" Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                    Height="16" Visibility="Collapsed" AutomationProperties.Name="Playing">
          <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource NovaAccent}"/>
          <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource NovaAccent}"/>
          <Rectangle x:Name="Bar3" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource NovaAccent}"/>
          <Rectangle x:Name="Bar4" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource NovaAccent}"/>
        </StackPanel>
      </Grid>

      <!-- Alerts: a round badge (chat app, Wi-Fi, volume...) and one line of text. In the compact state they replace the clock for a few seconds. -->
      <StackPanel x:Name="NoticeRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,4,0,0">
        <Border x:Name="NoticeBadge" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" VerticalAlignment="Center"
                Visibility="Collapsed" Background="#25D366">
          <TextBlock x:Name="NoticeGlyph" Style="{StaticResource NovaGlyph}" FontSize="12" Foreground="White" HorizontalAlignment="Center"
                     Text="&#xE8BD;"/>
        </Border>
        <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   Foreground="{DynamicResource NovaOnSurface}"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="NOVA notice"/>
      </StackPanel>

      <!-- Expanded content: 7 pages, one at a time (the last three are built in IslandWindow.Extras.cs) -->
      <StackPanel x:Name="ExpandedPanel" Visibility="Collapsed" Width="380" Margin="0,6,0,0">

        <!-- Header: page counter on the left, the time on the right (as in the concept) -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="PageCounter" Style="{StaticResource NovaTab}" FontSize="13" Padding="8,2" Tag="on"
                  ToolTip="Pindah halaman" AutomationProperties.Name="Nomor halaman, klik untuk halaman berikutnya" Click="OnPageNext"/>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                       Foreground="{DynamicResource NovaOnSurface}" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
              <Button x:Name="PagePrev" Style="{StaticResource NovaIconButton}" Width="24" Height="24" FontSize="11" Margin="0" Content="&#xE76B;"
                      ToolTip="Halaman sebelumnya" AutomationProperties.Name="Halaman sebelumnya" Click="OnPagePrev"/>
              <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"/>
              <Button x:Name="PageNext" Style="{StaticResource NovaIconButton}" Width="24" Height="24" FontSize="11" Margin="0" Content="&#xE76C;"
                      ToolTip="Halaman berikutnya" AutomationProperties.Name="Halaman berikutnya" Click="OnPageNext"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="Waktu">
            <TextBlock x:Name="HdrTime" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
            <TextBlock x:Name="HdrDate" HorizontalAlignment="Right" FontSize="10" Opacity="0.75" Foreground="{DynamicResource NovaOnSurface}"/>
          </StackPanel>
        </Grid>

        <Border x:Name="PageCard" CornerRadius="18" Padding="10,8" BorderThickness="1"
                Background="#14FFFFFF" BorderBrush="#2EFFFFFF">
        <Grid x:Name="PageHost">

          <!-- 1: Wi-Fi, sound, dll -->
          <StackPanel x:Name="PageQuick">
          <StackPanel x:Name="QuickMain">
            <TextBlock x:Name="DateText" Visibility="Collapsed"/>
            <Border CornerRadius="14" Padding="10,6" Background="#14FFFFFF">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="Jaringan">
                  <TextBlock x:Name="WifiChipGlyph" Style="{StaticResource NovaGlyph}" FontSize="18" Margin="0,0,8,0" Text="&#xE701;"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WifiChipName" FontSize="12" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                    <TextBlock x:Name="WifiChipState" FontSize="10" Opacity="0.65" Foreground="{DynamicResource NovaOnSurface}"/>
                  </StackPanel>
                </StackPanel>
                <Grid x:Name="VolumeRow" Grid.Column="1" Margin="14,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="VolumeIcon" Style="{StaticResource NovaGlyph}" FontSize="16" Margin="0,0,8,0" Text="&#xE995;"/>
                  <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          AutomationProperties.Name="Volume" ValueChanged="OnVolumeSlider"/>
                  <TextBlock x:Name="VolumeValue" Grid.Column="2" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource NovaOnSurface}"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Baterai">
                  <TextBlock x:Name="BatteryChipGlyph" Style="{StaticResource NovaGlyph}" FontSize="16" Margin="0,0,5,0" Text="&#xE83F;"/>
                  <TextBlock x:Name="BatteryChipText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource NovaOnSurface}"/>
                </StackPanel>
              </Grid>
            </Border>
            <UniformGrid Columns="7" Margin="0,10,0,0">
              <Button x:Name="TglWifi" Style="{StaticResource NovaIconButton}" Content="&#xE701;" ToolTip="Wi-Fi" AutomationProperties.Name="Buka pengaturan Wi-Fi" Click="OnTglWifi"/>
              <Button x:Name="TglSound" Style="{StaticResource NovaIconButton}" Content="&#xE767;" ToolTip="Bisukan / aktifkan suara" AutomationProperties.Name="Bisukan atau aktifkan suara" Click="OnTglSound"/>
              <Button x:Name="TglBluetooth" Style="{StaticResource NovaIconButton}" Content="&#xE702;" ToolTip="Bluetooth" AutomationProperties.Name="Buka pengaturan Bluetooth" Click="OnTglBluetooth"/>
              <Button x:Name="TglAirplane" Style="{StaticResource NovaIconButton}" Content="&#xE709;" ToolTip="Mode pesawat" AutomationProperties.Name="Buka pengaturan mode pesawat" Click="OnTglAirplane"/>
              <Button x:Name="TglBright" Style="{StaticResource NovaIconButton}" Content="&#xE706;" ToolTip="Kecerahan" AutomationProperties.Name="Kecerahan layar" Click="OnToolBright"/>
              <Button x:Name="TglNight" Style="{StaticResource NovaIconButton}" Content="&#xE708;" ToolTip="Night light" AutomationProperties.Name="Buka pengaturan Night light" Click="OnToolNight"/>
              <Button x:Name="TglMore" Style="{StaticResource NovaIconButton}" Content="&#xE76C;" ToolTip="Halaman berikutnya" AutomationProperties.Name="Halaman berikutnya" Click="OnPageNext"/>
            </UniformGrid>
            <Grid x:Name="BrightRow" Visibility="Collapsed" Margin="6,8,6,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource NovaGlyph}" FontSize="16" Margin="0,0,12,0" Text="&#xE706;"/>
              <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="5" Maximum="100" VerticalAlignment="Center"
                      AutomationProperties.Name="Kecerahan layar" PreviewMouseLeftButtonUp="OnBrightCommit" PreviewKeyUp="OnBrightKeyCommit"/>
            </Grid>
            <!-- System load: CPU, memory, disk, network. Each tile has a label, a value and a thin bar. -->
            <UniformGrid Columns="4" Margin="0,10,0,0" AutomationProperties.Name="Pemakaian sistem">
              <Border CornerRadius="10" Padding="8,5" Margin="0,0,3,0" Background="#14FFFFFF">
                <StackPanel>
                  <TextBlock Text="CPU" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="CpuVal" Text="–" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <Border Height="3" CornerRadius="1.5" Margin="0,3,0,0" Background="#22FFFFFF" ClipToBounds="True">
                    <Border x:Name="CpuBar" HorizontalAlignment="Stretch" CornerRadius="1.5" RenderTransformOrigin="0,0.5" Background="{DynamicResource NovaAccent}">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Border>
                </StackPanel>
              </Border>
              <Border CornerRadius="10" Padding="8,5" Margin="3,0" Background="#14FFFFFF">
                <StackPanel>
                  <TextBlock Text="Memori" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="RamVal" Text="–" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <Border Height="3" CornerRadius="1.5" Margin="0,3,0,0" Background="#22FFFFFF" ClipToBounds="True">
                    <Border x:Name="RamBar" HorizontalAlignment="Stretch" CornerRadius="1.5" RenderTransformOrigin="0,0.5" Background="{DynamicResource NovaAccent}">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Border>
                </StackPanel>
              </Border>
              <Border CornerRadius="10" Padding="8,5" Margin="3,0" Background="#14FFFFFF">
                <StackPanel>
                  <TextBlock Text="Disk" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="DiskVal" Text="–" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <Border Height="3" CornerRadius="1.5" Margin="0,3,0,0" Background="#22FFFFFF" ClipToBounds="True">
                    <Border x:Name="DiskBar" HorizontalAlignment="Stretch" CornerRadius="1.5" RenderTransformOrigin="0,0.5" Background="{DynamicResource NovaAccent}">
                      <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Border>
                </StackPanel>
              </Border>
              <Border CornerRadius="10" Padding="8,5" Margin="3,0,0,0" Background="#14FFFFFF">
                <StackPanel>
                  <TextBlock Text="Jaringan" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="NetDown" Text="↓ –" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="NetUp" Text="↑ –" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <!-- Weather: always has its place on page 1 (a hint when it is switched off) -->
            <Border CornerRadius="10" Padding="10,6" Margin="0,8,0,0" Background="#14FFFFFF">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="WeatherGlyph" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Text="&#x1F324;"/>
                <TextBlock x:Name="WeatherText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" FontSize="12"
                           Foreground="{DynamicResource NovaOnSurface}" AutomationProperties.Name="Cuaca"/>
              </StackPanel>
            </Border>
          </StackPanel>   <!-- /QuickMain -->

            <!-- Wi-Fi / Bluetooth: on/off switch and a list to find and connect, right here (no trip to Windows Settings) -->
            <StackPanel x:Name="RadioView" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="RadioBack" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Margin="0" Content="&#xE72B;"
                        ToolTip="Kembali" AutomationProperties.Name="Kembali ke pengaturan cepat" Click="OnRadioBack"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="RadioTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="RadioStatus" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"
                             AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <ToggleButton x:Name="RadioSwitch" Grid.Column="2" Style="{StaticResource NovaSwitch}" Click="OnRadioSwitch"
                              AutomationProperties.Name="Nyalakan atau matikan"/>
              </Grid>
              <Grid Margin="0,8,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="RadioListLabel" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Foreground="{DynamicResource NovaOnSurface}"/>
                <Button x:Name="RadioScan" Grid.Column="1" Style="{StaticResource NovaTab}" Content="Cari" Click="OnRadioScan"
                        AutomationProperties.Name="Cari jaringan atau perangkat"/>
              </Grid>
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="RadioList"/>
              </ScrollViewer>
              <Border x:Name="RadioPassBox" Visibility="Collapsed" CornerRadius="12" Padding="8" Margin="0,6,0,0" Background="#14808080">
                <StackPanel>
                  <TextBlock x:Name="RadioPassLabel" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="RadioPass" Style="{StaticResource NovaPassword}" KeyDown="OnRadioPassKey" AutomationProperties.Name="Kata sandi Wi-Fi"/>
                    <Button Grid.Column="1" Style="{StaticResource NovaIconButton}" Width="32" Height="32" Margin="6,0,0,0" Content="&#xE73E;"
                            ToolTip="Sambungkan" AutomationProperties.Name="Sambungkan" Click="OnRadioConnect"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Button Style="{StaticResource NovaTab}" HorizontalAlignment="Right" Margin="0,4,0,0" FontSize="11" Content="Pengaturan Windows…"
                      AutomationProperties.Name="Buka pengaturan Windows untuk ini" Click="OnRadioOpenSettings"/>
            </StackPanel>
          </StackPanel>

          <!-- 2: Music -->
          <Grid x:Name="PageMusic" Visibility="Collapsed">
            <TextBlock x:Name="NoMusicText" Text="Tidak ada musik yang diputar. Putar lagu di Spotify, browser, atau pemutar lain."
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.7" Foreground="{DynamicResource NovaOnSurface}"/>
            <Grid x:Name="MediaCard" Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Kontrol musik">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource NovaSurfaceAlt}">
                <Grid>
                  <TextBlock Text="&#xE8D6;" Style="{StaticResource NovaGlyph}" FontSize="26" HorizontalAlignment="Center" Opacity="0.55"/>
                  <Image x:Name="ArtImage" Width="64" Height="64" Stretch="UniformToFill"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="MediaSource" Grid.Column="1" FontSize="11" Opacity="0.65" Margin="8,2,0,0" Foreground="{DynamicResource NovaAccent}" AutomationProperties.Name="Aplikasi sumber"/>
                </Grid>
                <TextBlock x:Name="MediaArtist" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                <ProgressBar x:Name="Progress" Style="{StaticResource NovaThinProgress}" Margin="0,8,0,0" AutomationProperties.Name="Progres lagu"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                  <Button x:Name="PrevButton" Style="{StaticResource NovaIconButton}" Content="&#xE892;" ToolTip="Sebelumnya" AutomationProperties.Name="Lagu sebelumnya" Click="OnPrevClick"/>
                  <Button x:Name="PlayButton" Style="{StaticResource NovaIconButton}" Content="&#xE768;" ToolTip="Putar / jeda" AutomationProperties.Name="Putar atau jeda" Click="OnPlayClick"/>
                  <Button x:Name="NextButton" Style="{StaticResource NovaIconButton}" Content="&#xE893;" ToolTip="Berikutnya" AutomationProperties.Name="Lagu berikutnya" Click="OnNextClick"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="LyricPanel" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Lirik">
                  <TextBlock x:Name="LyricText" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="LyricNext" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap" FontSize="12" Opacity="0.55" Margin="0,3,0,0" Foreground="{DynamicResource NovaOnSurface}"/>
                </StackPanel>
                <StackPanel x:Name="Wave" Grid.Column="1" Orientation="Horizontal" Height="32" VerticalAlignment="Bottom" Margin="12,0,0,0"
                            AutomationProperties.Name="Level suara"/>
              </Grid>
              <Button x:Name="LyricEnableButton" Grid.Row="2" Grid.ColumnSpan="2" Content="Aktifkan lirik" Style="{StaticResource NovaTab}"
                      HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" Click="OnEnableLyrics"
                      ToolTip="Mengirim judul dan artis lagu ke lrclib.net"
                      AutomationProperties.Name="Aktifkan lirik. Judul dan artis lagu dikirim ke lrclib.net"/>
            </Grid>
          </Grid>

          <!-- 3: Notes + Clipboard (+ Shelf) -->
          <StackPanel x:Name="PageNotes" Visibility="Collapsed">
            <Border CornerRadius="14" Padding="2" HorizontalAlignment="Center" Background="#14808080">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SubNotes" Content="Catatan" Style="{StaticResource NovaTab}" Tag="on" Click="OnSubNotes" AutomationProperties.Name="Catatan"/>
                <Button x:Name="SubClip" Content="Clipboard" Style="{StaticResource NovaTab}" Click="OnSubClip" AutomationProperties.Name="Riwayat clipboard"/>
                <Button x:Name="SubShelf" Content="Rak file" Style="{StaticResource NovaTab}" Click="OnSubShelf" AutomationProperties.Name="Rak file sementara"/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="NotesView" Margin="0,8,0,0">
              <!-- The list: every note, scrollable; click one to read and edit it in full -->
              <StackPanel x:Name="NotesListView">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="NoteInput" Style="{StaticResource NovaInput}" Tag="Tulis catatan lalu tekan Enter…" MaxLength="1000" AutomationProperties.Name="Catatan baru" KeyDown="OnNoteKey"/>
                  <Button x:Name="NoteAdd" Grid.Column="1" Style="{StaticResource NovaIconButton}" Margin="6,0,0,0" Width="32" Height="32" Content="&#xE710;" ToolTip="Tambah catatan" AutomationProperties.Name="Tambah catatan" Click="OnNoteAdd"/>
                </Grid>
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,0,0">
                  <StackPanel x:Name="NotesList"/>
                </ScrollViewer>
              </StackPanel>
              <!-- The detail: the whole note, editable -->
              <StackPanel x:Name="NoteDetail" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="NoteBack" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Margin="0" Content="&#xE72B;"
                          ToolTip="Kembali ke daftar" AutomationProperties.Name="Kembali ke daftar catatan" Click="OnNoteBack"/>
                  <TextBlock x:Name="NoteStamp" Grid.Column="1" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                </Grid>
                <Border CornerRadius="10" Background="{DynamicResource NovaSurfaceAlt}" Padding="8,6" Margin="0,6,0,0">
                  <TextBox x:Name="NoteEdit" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                           Foreground="{DynamicResource NovaOnSurface}" CaretBrush="{DynamicResource NovaOnSurface}" SelectionBrush="{DynamicResource NovaAccent}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                           MaxLength="1000" AutomationProperties.Name="Isi catatan" TextChanged="OnNoteEditChanged"/>
                </Border>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="NoteCount" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Foreground="{DynamicResource NovaOnSurface}"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Salin" Style="{StaticResource NovaTab}" Click="OnNoteCopy" AutomationProperties.Name="Salin isi catatan"/>
                    <Button x:Name="NoteSave" Content="Simpan" Style="{StaticResource NovaTab}" Click="OnNoteSave" AutomationProperties.Name="Simpan perubahan catatan"/>
                    <Button Content="Hapus" Style="{StaticResource NovaTab}" Click="OnNoteDelete" AutomationProperties.Name="Hapus catatan ini"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ClipView" Margin="0,8,0,0" Visibility="Collapsed">
              <TextBlock x:Name="ClipHint" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" FontSize="12" Foreground="{DynamicResource NovaOnSurface}"/>
              <Button x:Name="ClipEnableButton" Content="Aktifkan riwayat clipboard" Style="{StaticResource NovaTab}" Visibility="Collapsed"
                      HorizontalAlignment="Center" Margin="0,6,0,0" Click="OnClipEnable"
                      ToolTip="Teks, gambar, dan file yang disalin. Hanya di memori, tidak disimpan ke disk"
                      AutomationProperties.Name="Aktifkan riwayat clipboard. Hanya di memori, tidak disimpan ke disk"/>
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="ClipList"/>
              </ScrollViewer>
              <Button x:Name="ClipClearButton" Content="Kosongkan riwayat" Style="{StaticResource NovaTab}" Visibility="Collapsed"
                      HorizontalAlignment="Right" Margin="0,6,0,0" Click="OnClipClear" AutomationProperties.Name="Kosongkan riwayat clipboard"/>
            </StackPanel>
            <StackPanel x:Name="ShelfPage" Visibility="Collapsed" Margin="0,8,0,0">
              <Border x:Name="ShelfBox" MinHeight="88" CornerRadius="14" Padding="8" BorderThickness="1.5"
                      Background="#18808080" BorderBrush="{DynamicResource NovaBorder}" AutomationProperties.Name="Area rak file">
                <Grid>
                  <TextBlock x:Name="ShelfHint" Text="Jatuhkan file di sini untuk disimpan sebentar, lalu seret keluar ke tempat tujuan."
                             TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource NovaOnSurface}"/>
                  <WrapPanel x:Name="ShelfItems"/>
                </Grid>
              </Border>
              <Button x:Name="ShelfClearButton" Content="Kosongkan rak" Style="{StaticResource NovaTab}" Visibility="Collapsed"
                      HorizontalAlignment="Right" Margin="0,6,0,0" AutomationProperties.Name="Kosongkan rak file" Click="OnShelfClear"/>
            </StackPanel>
          </StackPanel>

          <!-- 4: Plan -->
          <StackPanel x:Name="PagePlan" Visibility="Collapsed">
            <TextBlock x:Name="PlanSummary" FontSize="12" Opacity="0.85" Foreground="{DynamicResource NovaOnSurface}"/>
            <ProgressBar x:Name="PlanProgress" Style="{StaticResource NovaThinProgress}" Margin="0,6,0,8" AutomationProperties.Name="Progres rencana"/>
            <StackPanel x:Name="PlanList"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PlanInput" Style="{StaticResource NovaInput}" Tag="Tugas baru (akhiri dengan ! = penting)" MaxLength="100" AutomationProperties.Name="Tugas baru" KeyDown="OnPlanKey"/>
              <TextBox x:Name="PlanTime" Grid.Column="1" Style="{StaticResource NovaInput}" Tag="19:00" MaxLength="20" Margin="6,0,0,0" ToolTip="Jam, misalnya 19:00" AutomationProperties.Name="Jam tugas" KeyDown="OnPlanKey"/>
              <Button Grid.Column="2" Style="{StaticResource NovaIconButton}" Margin="6,0,0,0" Width="32" Height="32" Content="&#xE710;" ToolTip="Tambah tugas" AutomationProperties.Name="Tambah tugas" Click="OnPlanAdd"/>
            </Grid>
          </StackPanel>

          <!-- 5: Pomodoro -->
          <Grid x:Name="PagePomo" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="110" Height="110" Margin="4,0,18,0">
              <Ellipse Width="98" Height="98" StrokeThickness="8" Stroke="{DynamicResource NovaSurfaceAlt}"/>
              <Path x:Name="PomoArc" Stroke="#FFE5484D" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Sisa waktu sesi"/>
              <Button x:Name="PomoToggle" Style="{StaticResource NovaIconButton}" Width="44" Height="44" FontSize="20" Content="&#xE768;"
                      ToolTip="Mulai / jeda" AutomationProperties.Name="Mulai atau jeda timer" Click="OnPomoToggle"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="PomoPhase" FontSize="13" Opacity="0.85" Foreground="{DynamicResource NovaOnSurface}"/>
              <TextBlock x:Name="PomoTime" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}" AutomationProperties.Name="Sisa waktu"/>
              <Border CornerRadius="10" Padding="8,5" Margin="0,4,0,0" Background="#14808080">
                <StackPanel>
                  <TextBlock Text="Todo" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="TodoTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NovaOnSurface}"/>
                  <TextBlock x:Name="TodoTime" FontSize="10" Opacity="0.6" Foreground="{DynamicResource NovaOnSurface}"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="PomoReset" Style="{StaticResource NovaIconButton}" Width="28" Height="28" FontSize="13" Content="&#xE777;" ToolTip="Atur ulang" AutomationProperties.Name="Atur ulang timer" Click="OnPomoReset"/>
                <Button x:Name="PomoSkip" Style="{StaticResource NovaIconButton}" Width="28" Height="28" FontSize="13" Content="&#xE893;" ToolTip="Lewati fase" AutomationProperties.Name="Lewati fase" Click="OnPomoSkip"/>
                <TextBlock x:Name="PomoSessions" FontSize="11" Opacity="0.75" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource NovaOnSurface}"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- 6: Calendar -->
          <StackPanel x:Name="PageCalendar" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Width="196">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource NovaIconButton}" Width="26" Height="26" FontSize="10" Margin="0" Content="&#xE76B;" AutomationProperties.Name="Bulan sebelumnya" Click="OnCalPrev"/>
                  <TextBlock x:Name="CalTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                  <Button Grid.Column="2" Style="{StaticResource NovaIconButton}" Width="26" Height="26" FontSize="10" Margin="0" Content="&#xE76C;" AutomationProperties.Name="Bulan berikutnya" Click="OnCalNext"/>
                </Grid>
                <UniformGrid x:Name="CalGrid" Columns="7"/>
              </StackPanel>
              <Border Grid.Column="1" Margin="12,0,0,0" Padding="10,8" CornerRadius="14" Background="#14808080" AutomationProperties.Name="Tanggal terpilih">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DayNumber" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource NovaOnSurface}"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DayName" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NovaAccent}"/>
                      <TextBlock x:Name="DayMonth" FontSize="11" Opacity="0.7" Foreground="{DynamicResource NovaOnSurface}"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="AgendaTitle" Visibility="Collapsed"/>
                  <StackPanel x:Name="AgendaList" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="EventKind" Style="{StaticResource NovaTab}" Content="Acara" Margin="0,0,6,0" Click="OnEventKind"
                      ToolTip="Ganti antara menambah acara dan menambah tugas untuk tanggal yang dipilih" AutomationProperties.Name="Jenis yang ditambah: acara"/>
              <TextBox x:Name="EventInput" Grid.Column="1" Style="{StaticResource NovaInput}" Tag="Acara baru" MaxLength="100" AutomationProperties.Name="Judul baru" KeyDown="OnEventKey"/>
              <TextBox x:Name="EventTime" Grid.Column="2" Style="{StaticResource NovaInput}" Tag="14:30" MaxLength="5" Margin="6,0,0,0" ToolTip="Jam, misalnya 14:30" AutomationProperties.Name="Jam" KeyDown="OnEventKey"/>
              <Button Grid.Column="3" Style="{StaticResource NovaIconButton}" Margin="6,0,0,0" Width="32" Height="32" Content="&#xE710;" ToolTip="Tambah" AutomationProperties.Name="Tambah acara atau tugas" Click="OnEventAdd"/>
            </Grid>
          </StackPanel>

        </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button x:Name="DockButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE71D;"
                  ToolTip="Fokus ke dock (keyboard)" AutomationProperties.Name="Move keyboard focus to the app dock" Click="OnDockClick"/>
          <Button x:Name="ClipboardButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE77F;" Visibility="Collapsed"
                  ToolTip="Jendela clipboard" AutomationProperties.Name="Open clipboard history" Click="OnClipboardClick"/>
          <Button x:Name="LockButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE72E;"
                  ToolTip="Kunci layar (Win+L)" AutomationProperties.Name="Lock the screen" Click="OnLockClick"/>
          <Button x:Name="SettingsButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE713;"
                  ToolTip="Pengaturan NOVA" AutomationProperties.Name="Open NOVA settings" Click="OnSettingsClick"/>
          <Button x:Name="ResetButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE777;"
                  ToolTip="Reset tata letak" AutomationProperties.Name="Reset layout and settings to defaults" Click="OnResetClick"/>
          <Button x:Name="ExitButton" Style="{StaticResource NovaIconButton}" Width="30" Height="30" Content="&#xE7E8;"
                  ToolTip="Keluar dari NOVA" AutomationProperties.Name="Exit NOVA" Click="OnExitClick"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
