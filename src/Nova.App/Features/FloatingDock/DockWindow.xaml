<Window x:Class="Nova.App.Features.FloatingDock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Dock" AutomationProperties.Name="NOVA app dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" SizeChanged="OnSizeChanged" SourceInitialized="OnSourceInitialized"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
        IsKeyboardFocusWithinChanged="OnKeyboardFocusWithinChanged" KeyDown="OnWindowKeyDown">
  <!-- In the normal (transparent) mode this window is as wide as the screen and has see-through room above the dock:
       icons grow into that room when the pointer comes near, and clicks on the see-through parts fall through to the windows below.
       The dock itself sits at the bottom centre. -->
  <Grid x:Name="Root">
    <!-- Edge handle, shown only in "reveal on edge hover" mode while the dock is hidden -->
    <Border x:Name="Handle" Visibility="Collapsed" Width="180" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#01000000" AutomationProperties.Name="Reveal app dock">
      <!-- No visible bar: while hidden the dock leaves nothing on screen; the invisible strip only catches the pointer. -->
    </Border>
    <Border x:Name="Panel" CornerRadius="22" Padding="10,6,10,5" BorderThickness="1" AllowDrop="True"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="{DynamicResource NovaSurface}" BorderBrush="{DynamicResource NovaBorder}"
            DragOver="OnPanelDragOver" Drop="OnPanelDrop">
      <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Bottom" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
  </Grid>
</Window>
